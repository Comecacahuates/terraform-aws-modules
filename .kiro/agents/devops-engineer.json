{
  "name": "devops-engineer",
  "description": "a devops engineer specialized in aws, terraform, infrastructure as code patterns and best practices, system design and architecture, cloud providers",
  "prompt": "file://devops-engineer-prompt.md",
  "mcpServers": {
    "awslabs.terraform-mcp-server": {
      "command": "uvx",
      "args": ["awslabs.terraform-mcp-server@latest"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false,
      "autoApprove": []
    }
  },
  "tools": ["*"],
  "toolAliases": {},
  "allowedTools": ["fs_write", "fs_read", "web_search", "web_fetch"],
  "resources": [
    "file://AGENTS.md",
    "file://README.md",
    "file://.agents/steering/**/*.md",
    "skill://.kiro/skills/**/SKILL.md"
  ],
  "hooks": {},
  "toolsSettings": {},
  "useLegacyMcpJson": false,
  "model": null
}
